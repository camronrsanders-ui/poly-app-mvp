rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function conversationExists(conversationId) {
      return exists(/databases/$(database)/documents/conversations/$(conversationId));
    }
    function isConversationParticipant(conversationId) {
      return signedIn()
        && conversationExists(conversationId)
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantUids;
    }
    function reciprocalLikesExist(a, b) {
      return exists(/databases/$(database)/documents/likes/$(a + '_' + b))
        && exists(/databases/$(database)/documents/likes/$(b + '_' + a));
    }
    function blockedEitherWay(a, b) {
      return exists(/databases/$(database)/documents/blocks/$(a + '_' + b))
        || exists(/databases/$(database)/documents/blocks/$(b + '_' + a));
    }
    function activeMatchExists(matchId) {
      return exists(/databases/$(database)/documents/matches/$(matchId))
        && get(/databases/$(database)/documents/matches/$(matchId)).data.active == true;
    }

    match /users/{uid} {
      allow read, create, update: if isSelf(uid);
      allow delete: if false;
    }

    match /profiles/{uid} {
      allow create, update, delete: if isSelf(uid);
      allow read: if signedIn() && (isSelf(uid) || resource.data.profileVisibility == 'public');
    }

    match /relationship_cards/{cardId} {
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid;
      allow read: if signedIn() && (
        resource.data.ownerUid == request.auth.uid ||
        resource.data.visibility == 'public' ||
        resource.data.visibility == 'unnamed_public'
      );
    }

    match /likes/{likeId} {
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid != request.auth.uid
        && !blockedEitherWay(request.resource.data.fromUid, request.resource.data.toUid);
      allow read: if signedIn() && (
        resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid
      );
      allow delete: if signedIn() && resource.data.fromUid == request.auth.uid;
      allow update: if false;
    }

    match /matches/{matchId} {
      allow read: if signedIn() && (
        resource.data.userAUid == request.auth.uid || resource.data.userBUid == request.auth.uid
      );
      allow create: if signedIn()
        && request.resource.data.userAUid != request.resource.data.userBUid
        && (request.resource.data.userAUid == request.auth.uid || request.resource.data.userBUid == request.auth.uid)
        && reciprocalLikesExist(request.resource.data.userAUid, request.resource.data.userBUid)
        && !blockedEitherWay(request.resource.data.userAUid, request.resource.data.userBUid)
        && request.resource.data.active == true;
      allow update, delete: if false;
    }

    match /conversations/{conversationId} {
      allow read: if signedIn()
        && request.auth.uid in resource.data.participantUids
        && !blockedEitherWay(resource.data.participantUids[0], resource.data.participantUids[1]);
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.participantUids
        && request.resource.data.participantUids.size() == 2
        && activeMatchExists(conversationId)
        && !blockedEitherWay(request.resource.data.participantUids[0], request.resource.data.participantUids[1]);
      allow update: if signedIn()
        && request.auth.uid in resource.data.participantUids
        && request.resource.data.participantUids == resource.data.participantUids
        && !blockedEitherWay(resource.data.participantUids[0], resource.data.participantUids[1]);
      allow delete: if false;
    }

    match /messages/{messageId} {
      allow create: if signedIn()
        && request.resource.data.senderUid == request.auth.uid
        && isConversationParticipant(request.resource.data.conversationId)
        && !blockedEitherWay(
          get(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId)).data.participantUids[0],
          get(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId)).data.participantUids[1]
        );
      allow read: if signedIn() && isConversationParticipant(resource.data.conversationId);
      allow update: if signedIn()
        && isConversationParticipant(resource.data.conversationId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']);
      allow delete: if false;
    }

    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.reportedUid != request.auth.uid;
      allow read: if signedIn() && resource.data.reporterUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /blocks/{blockId} {
      allow create: if signedIn()
        && request.resource.data.blockerUid == request.auth.uid
        && request.resource.data.blockedUid != request.auth.uid;
      allow read, delete: if signedIn() && resource.data.blockerUid == request.auth.uid;
      allow update: if false;
    }
  }
}
