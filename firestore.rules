rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }

    function userIsActive(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
        && get(/databases/$(database)/documents/users/$(uid)).data.accountStatus == 'active';
    }

    function conversationExists(conversationId) {
      return exists(/databases/$(database)/documents/conversations/$(conversationId));
    }

    function blockedEitherWay(a, b) {
      return exists(/databases/$(database)/documents/blocks/$(a + '_' + b))
        || exists(/databases/$(database)/documents/blocks/$(b + '_' + a));
    }

    function activeMatchBetween(a, b) {
      return (exists(/databases/$(database)/documents/matches/$(a + '_' + b))
        && get(/databases/$(database)/documents/matches/$(a + '_' + b)).data.active == true)
        || (exists(/databases/$(database)/documents/matches/$(b + '_' + a))
        && get(/databases/$(database)/documents/matches/$(b + '_' + a)).data.active == true);
    }

    function isConversationParticipant(conversationId) {
      return signedIn() && conversationExists(conversationId)
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantUids;
    }

    function conversationIsUnblocked(conversationId) {
      return conversationExists(conversationId)
        && !blockedEitherWay(
          get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantUids[0],
          get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantUids[1]);
    }

    function conversationIsActive(conversationId) {
      return conversationExists(conversationId)
        && get(/databases/$(database)/documents/conversations/$(conversationId)).data.active == true;
    }

    function conversationParticipants(conversationId) {
      return get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantUids;
    }

    function validProfile(data, uid) {
      return data.keys().hasOnly([
          'uid', 'displayName', 'age', 'city', 'region', 'bio', 'headline',
          'genderIdentity', 'pronouns', 'orientation', 'customIdentityTags',
          'relationshipStructure', 'relationshipStatus', 'partnered',
          'openToConnections', 'intentionTags', 'interests', 'lookingForNote',
          'ageMin', 'ageMax', 'distanceRadius', 'preferredStructures',
          'preferredIntentions', 'profileVisibility', 'mapVisibility',
          'createdAt', 'updatedAt'
        ])
        && data.uid == uid
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.age is int && data.age >= 18 && data.age <= 120
        && data.city is string && data.city.size() <= 100
        && data.region is string && data.region.size() <= 100
        && data.bio is string && data.bio.size() <= 1500
        && data.headline is string && data.headline.size() <= 160
        && data.genderIdentity is string && data.genderIdentity.size() <= 100
        && data.pronouns is string && data.pronouns.size() <= 100
        && data.orientation is string && data.orientation.size() <= 100
        && data.customIdentityTags is list && data.customIdentityTags.size() <= 12
        && data.relationshipStructure is string && data.relationshipStructure.size() <= 120
        && data.relationshipStatus is string && data.relationshipStatus.size() <= 120
        && data.partnered is bool
        && data.openToConnections is bool
        && data.intentionTags is list && data.intentionTags.size() <= 12
        && data.interests is list && data.interests.size() <= 20
        && data.lookingForNote is string && data.lookingForNote.size() <= 1200
        && data.ageMin is int && data.ageMin >= 18 && data.ageMin <= 120
        && data.ageMax is int && data.ageMax >= data.ageMin && data.ageMax <= 120
        && data.distanceRadius is int && data.distanceRadius >= 1 && data.distanceRadius <= 500
        && data.preferredStructures is list && data.preferredStructures.size() <= 12
        && data.preferredIntentions is list && data.preferredIntentions.size() <= 12
        && data.profileVisibility in ['public', 'hidden', 'matches_only']
        && data.mapVisibility in ['public', 'matches_only', 'private'];
    }

    function validRelationshipCard(data, ownerUid) {
      return data.ownerUid == ownerUid
        && data.label is string && data.label.size() >= 1 && data.label.size() <= 100
        && data.connectionType is string && data.connectionType.size() >= 1 && data.connectionType.size() <= 100
        && data.displayNameOptional is string && data.displayNameOptional.size() <= 100
        && data.status is string && data.status.size() <= 80
        && data.note is string && data.note.size() <= 1000
        && data.visibility in ['public', 'matches_only', 'private', 'unnamed_public']
        && data.sortOrder is int && data.sortOrder >= 0 && data.sortOrder <= 10000
        && data.isActive is bool;
    }

    match /users/{uid} {
      allow create: if isSelf(uid) && request.resource.data.uid == request.auth.uid && request.resource.data.accountStatus == 'active';
      allow read: if isSelf(uid);
      allow update: if isSelf(uid) && request.resource.data.uid == resource.data.uid
        && request.resource.data.accountStatus == resource.data.accountStatus
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    // Full profile documents include discovery preferences. Other users receive
    // privacy-safe profile views through trusted callable Functions instead.
    match /profiles/{uid} {
      allow create: if isSelf(uid) && validProfile(request.resource.data, uid);
      allow update: if isSelf(uid) && validProfile(request.resource.data, uid)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow read, delete: if isSelf(uid);
    }

    match /relationship_cards/{cardId} {
      allow create: if signedIn() && validRelationshipCard(request.resource.data, request.auth.uid);
      allow update: if signedIn() && resource.data.ownerUid == request.auth.uid
        && validRelationshipCard(request.resource.data, request.auth.uid)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow read: if signedIn() && (resource.data.ownerUid == request.auth.uid || (userIsActive(resource.data.ownerUid)
        && !blockedEitherWay(request.auth.uid, resource.data.ownerUid)
        && (resource.data.visibility == 'public' || resource.data.visibility == 'unnamed_public'
        || (resource.data.visibility == 'matches_only' && activeMatchBetween(request.auth.uid, resource.data.ownerUid)))));
    }

    match /likes/{likeId} {
      allow create, update: if false;
      // A user can inspect only likes they sent. Incoming interest remains hidden
      // until trusted backend matching creates an active match.
      allow read, delete: if signedIn() && resource.data.fromUid == request.auth.uid;
    }

    match /matches/{matchId} {
      allow read: if signedIn() && !blockedEitherWay(resource.data.userAUid, resource.data.userBUid)
        && (resource.data.userAUid == request.auth.uid || resource.data.userBUid == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /conversations/{conversationId} {
      allow read: if signedIn() && resource.data.active == true
        && request.auth.uid in resource.data.participantUids
        && userIsActive(resource.data.participantUids[0]) && userIsActive(resource.data.participantUids[1])
        && !blockedEitherWay(resource.data.participantUids[0], resource.data.participantUids[1]);
      allow create, delete: if false;
      allow update: if signedIn() && resource.data.active == true
        && request.auth.uid in resource.data.participantUids
        && request.resource.data.participantUids == resource.data.participantUids
        && request.resource.data.active == resource.data.active
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessageAt'])
        && !blockedEitherWay(resource.data.participantUids[0], resource.data.participantUids[1]);
    }

    match /messages/{messageId} {
      allow create: if signedIn() && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.messageType == 'text' && request.resource.data.isDeleted == false
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
        && request.resource.data.readBy is list && request.resource.data.readBy.size() == 1
        && request.resource.data.readBy[0] == request.auth.uid
        && isConversationParticipant(request.resource.data.conversationId)
        && conversationIsActive(request.resource.data.conversationId)
        && request.resource.data.readBy.hasOnly(conversationParticipants(request.resource.data.conversationId))
        && conversationIsUnblocked(request.resource.data.conversationId);
      allow read: if signedIn() && isConversationParticipant(resource.data.conversationId)
        && conversationIsActive(resource.data.conversationId)
        && conversationIsUnblocked(resource.data.conversationId);
      allow update: if signedIn() && isConversationParticipant(resource.data.conversationId)
        && conversationIsActive(resource.data.conversationId)
        && conversationIsUnblocked(resource.data.conversationId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
        && request.resource.data.readBy is list && request.resource.data.readBy.size() <= 2
        && request.resource.data.readBy.hasAll(resource.data.readBy)
        && request.resource.data.readBy.hasOnly(conversationParticipants(resource.data.conversationId))
        && request.auth.uid in request.resource.data.readBy;
      allow delete: if false;
    }

    match /reports/{reportId} {
      allow read: if signedIn() && resource.data.reporterUid == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /blocks/{blockId} {
      allow read: if signedIn() && resource.data.blockerUid == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /profile_media/{photoId} { allow read, write: if false; }
    match /private_media/{mediaId} { allow read, write: if false; }
    match /private_media_grants/{grantId} { allow read, write: if false; }
    match /private_media_requests/{requestId} { allow read, write: if false; }
    match /private_media_request_preferences/{preferenceId} { allow read, write: if false; }
    match /_rate_limits/{docId} { allow read, write: if false; }
  }
}
