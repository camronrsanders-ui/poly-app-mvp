{
  "name": "polycircle-functions",
  "private": true,
  "engines": {"node": "22"},
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth",
    "check:seed": "node --check scripts/seed_emulator.cjs",
    "seed:emulator": "node scripts/seed_emulator.cjs",
    "test": "node --test test/*.test.cjs",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.0.0",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
